[Unit]
Description=PS2000B Power Supply Dashboard
After=network.target

[Service]
Type=simple
User=wittr
Group=wittr
WorkingDirectory=/home/wittr/ps2000b-control
ExecStart=/home/wittr/ps2000b-control/.venv/bin/python3 cli.py serve --port /dev/ttyACM0 --host 0.0.0.0 --http-port 8181
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

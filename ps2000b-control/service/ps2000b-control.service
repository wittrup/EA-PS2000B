[Unit]
Description=PS2000B Power Supply Dashboard
After=network.target

[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/home/dev/EA-PS2000B/ps2000b-control
ExecStart=/home/dev/EA-PS2000B/ps2000b-control/.venv/bin/python3 cli.py serve --host 0.0.0.0 --http-port 8181
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
